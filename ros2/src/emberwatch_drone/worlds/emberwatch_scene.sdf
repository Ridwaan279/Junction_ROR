<?xml version="1.0" ?>
<!--
  EmberWatch REPRESENTATIVE scene. NOT a reconstruction of any real place, terrain or fire.
  * "sim_fire": fire/smoke are visual particle effects only (pattern from gz-sim
    examples/worlds/particle_emitter.sdf). No fire spread or physics is modelled.
  * "ember_drone": a KINEMATIC stand-in moved by gz VelocityControl (no rotor dynamics, no
    PX4, no collision avoidance). Its "sim_water" emitter is a labelled SIMULATED water-drop
    visual toggled on arrival; it does not affect the fire.
  Particle emitters need Gazebo's ogre2 renderer (the default) to be visible in the GUI.
-->
<sdf version="1.9">
  <world name="emberwatch_scene">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-particle-emitter-system" name="gz::sim::systems::ParticleEmitter"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.62 0.72 0.82 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>1 0.95 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>120 120</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>120 120</size></plane></geometry>
          <material><ambient>0.45 0.42 0.28 1</ambient><diffuse>0.45 0.42 0.28 1</diffuse></material></visual>
      </link>
    </model>

    <model name="launch_pad">
      <static>true</static>
      <pose>-12 -8 0.01 0 0 0</pose>
      <link name="l"><visual name="pad"><geometry><cylinder><radius>1.2</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.2 0.4 0.9 1</ambient><diffuse>0.2 0.4 0.9 1</diffuse></material></visual></link>
    </model>

    <!-- Representative fire at scene position (12.0, 8.0). Visual only. -->
    <model name="sim_fire">
      <static>true</static>
      <pose>12.0 8.0 0 0 0 0</pose>
      <link name="fire_link">
        <visual name="scorch"><pose>0 0 0.01 0 0 0</pose><geometry><cylinder><radius>2.5</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.08 0.06 0.05 1</ambient><diffuse>0.08 0.06 0.05 1</diffuse></material></visual>
        <particle_emitter name="flames" type="box">
          <pose>0 0 0.2 0 -1.5707 0</pose>
          <emitting>true</emitting>
          <size>3 3 0.2</size>
          <particle_size>0.6 0.6 0.6</particle_size>
          <lifetime>1.2</lifetime>
          <min_velocity>0.8</min_velocity>
          <max_velocity>1.8</max_velocity>
          <scale_rate>0.2</scale_rate>
          <rate>60</rate>
          <material>
            <diffuse>1.0 0.45 0.05</diffuse>
            <specular>1.0 0.45 0.05</specular>
            <pbr><metal><albedo_map>media/puff.png</albedo_map></metal></pbr>
          </material>
        </particle_emitter>
        <particle_emitter name="smoke" type="box">
          <pose>0 0 1.5 0 -1.5707 0</pose>
          <emitting>true</emitting>
          <size>2.5 2.5 0.5</size>
          <particle_size>1.2 1.2 1.2</particle_size>
          <lifetime>12</lifetime>
          <min_velocity>0.6</min_velocity>
          <max_velocity>1.2</max_velocity>
          <scale_rate>0.6</scale_rate>
          <rate>12</rate>
          <material>
            <diffuse>0.35 0.35 0.35</diffuse>
            <specular>0.2 0.2 0.2</specular>
            <pbr><metal><albedo_map>media/puff.png</albedo_map></metal></pbr>
          </material>
        </particle_emitter>
      </link>
    </model>

    <model name="tree_0"><static>true</static><pose>4.42 -2.08 0 0 0 0</pose>
      <link name="l">
        <visual name="trunk"><pose>0 0 1.16 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>2.31</length></cylinder></geometry>
          <material><ambient>0.35 0.22 0.12 1</ambient><diffuse>0.35 0.22 0.12 1</diffuse></material></visual>
        <visual name="crown"><pose>0 0 3.01 0 0 0</pose><geometry><sphere><radius>1.16</radius></sphere></geometry>
          <material><ambient>0.15 0.35 0.12 1</ambient><diffuse>0.15 0.35 0.12 1</diffuse></material></visual>
      </link></model>
    <model name="tree_1"><static>true</static><pose>-2.12 7.93 0 0 0 0</pose>
      <link name="l">
        <visual name="trunk"><pose>0 0 0.98 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>1.96</length></cylinder></geometry>
          <material><ambient>0.35 0.22 0.12 1</ambient><diffuse>0.35 0.22 0.12 1</diffuse></material></visual>
        <visual name="crown"><pose>0 0 2.54 0 0 0</pose><geometry><sphere><radius>0.98</radius></sphere></geometry>
          <material><ambient>0.15 0.35 0.12 1</ambient><diffuse>0.15 0.35 0.12 1</diffuse></material></visual>
      </link></model>
    <model name="tree_2"><static>true</static><pose>-2.49 7.19 0 0 0 0</pose>
      <link name="l">
        <visual name="trunk"><pose>0 0 0.77 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>1.55</length></cylinder></geometry>
          <material><ambient>0.35 0.22 0.12 1</ambient><diffuse>0.35 0.22 0.12 1</diffuse></material></visual>
        <visual name="crown"><pose>0 0 2.01 0 0 0</pose><geometry><sphere><radius>0.77</radius></sphere></geometry>
          <material><ambient>0.15 0.35 0.12 1</ambient><diffuse>0.15 0.35 0.12 1</diffuse></material></visual>
      </link></model>
    <model name="tree_3"><static>true</static><pose>7.27 -4.18 0 0 0 0</pose>
      <link name="l">
        <visual name="trunk"><pose>0 0 0.81 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>1.61</length></cylinder></geometry>
          <material><ambient>0.35 0.22 0.12 1</ambient><diffuse>0.35 0.22 0.12 1</diffuse></material></visual>
        <visual name="crown"><pose>0 0 2.10 0 0 0</pose><geometry><sphere><radius>0.81</radius></sphere></geometry>
          <material><ambient>0.15 0.35 0.12 1</ambient><diffuse>0.15 0.35 0.12 1</diffuse></material></visual>
      </link></model>
    <model name="tree_4"><static>true</static><pose>7.04 15.50 0 0 0 0</pose>
      <link name="l">
        <visual name="trunk"><pose>0 0 0.83 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>1.65</length></cylinder></geometry>
          <material><ambient>0.35 0.22 0.12 1</ambient><diffuse>0.35 0.22 0.12 1</diffuse></material></visual>
        <visual name="crown"><pose>0 0 2.15 0 0 0</pose><geometry><sphere><radius>0.83</radius></sphere></geometry>
          <material><ambient>0.15 0.35 0.12 1</ambient><diffuse>0.15 0.35 0.12 1</diffuse></material></visual>
      </link></model>
    <model name="tree_5"><static>true</static><pose>1.80 10.31 0 0 0 0</pose>
      <link name="l">
        <visual name="trunk"><pose>0 0 1.34 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>2.68</length></cylinder></geometry>
          <material><ambient>0.35 0.22 0.12 1</ambient><diffuse>0.35 0.22 0.12 1</diffuse></material></visual>
        <visual name="crown"><pose>0 0 3.49 0 0 0</pose><geometry><sphere><radius>1.34</radius></sphere></geometry>
          <material><ambient>0.15 0.35 0.12 1</ambient><diffuse>0.15 0.35 0.12 1</diffuse></material></visual>
      </link></model>
    <model name="tree_6"><static>true</static><pose>11.00 4.31 0 0 0 0</pose>
      <link name="l">
        <visual name="trunk"><pose>0 0 1.36 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>2.72</length></cylinder></geometry>
          <material><ambient>0.35 0.22 0.12 1</ambient><diffuse>0.35 0.22 0.12 1</diffuse></material></visual>
        <visual name="crown"><pose>0 0 3.54 0 0 0</pose><geometry><sphere><radius>1.36</radius></sphere></geometry>
          <material><ambient>0.15 0.35 0.12 1</ambient><diffuse>0.15 0.35 0.12 1</diffuse></material></visual>
      </link></model>
    <model name="tree_7"><static>true</static><pose>-2.79 16.32 0 0 0 0</pose>
      <link name="l">
        <visual name="trunk"><pose>0 0 0.93 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>1.86</length></cylinder></geometry>
          <material><ambient>0.35 0.22 0.12 1</ambient><diffuse>0.35 0.22 0.12 1</diffuse></material></visual>
        <visual name="crown"><pose>0 0 2.42 0 0 0</pose><geometry><sphere><radius>0.93</radius></sphere></geometry>
          <material><ambient>0.15 0.35 0.12 1</ambient><diffuse>0.15 0.35 0.12 1</diffuse></material></visual>
      </link></model>
    <model name="tree_8"><static>true</static><pose>-0.25 -2.94 0 0 0 0</pose>
      <link name="l">
        <visual name="trunk"><pose>0 0 0.94 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>1.89</length></cylinder></geometry>
          <material><ambient>0.35 0.22 0.12 1</ambient><diffuse>0.35 0.22 0.12 1</diffuse></material></visual>
        <visual name="crown"><pose>0 0 2.45 0 0 0</pose><geometry><sphere><radius>0.94</radius></sphere></geometry>
          <material><ambient>0.15 0.35 0.12 1</ambient><diffuse>0.15 0.35 0.12 1</diffuse></material></visual>
      </link></model>
    <model name="tree_9"><static>true</static><pose>17.22 -1.30 0 0 0 0</pose>
      <link name="l">
        <visual name="trunk"><pose>0 0 1.11 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>2.23</length></cylinder></geometry>
          <material><ambient>0.35 0.22 0.12 1</ambient><diffuse>0.35 0.22 0.12 1</diffuse></material></visual>
        <visual name="crown"><pose>0 0 2.90 0 0 0</pose><geometry><sphere><radius>1.11</radius></sphere></geometry>
          <material><ambient>0.15 0.35 0.12 1</ambient><diffuse>0.15 0.35 0.12 1</diffuse></material></visual>
      </link></model>
    <model name="tree_10"><static>true</static><pose>12.61 3.68 0 0 0 0</pose>
      <link name="l">
        <visual name="trunk"><pose>0 0 1.09 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>2.18</length></cylinder></geometry>
          <material><ambient>0.35 0.22 0.12 1</ambient><diffuse>0.35 0.22 0.12 1</diffuse></material></visual>
        <visual name="crown"><pose>0 0 2.84 0 0 0</pose><geometry><sphere><radius>1.09</radius></sphere></geometry>
          <material><ambient>0.15 0.35 0.12 1</ambient><diffuse>0.15 0.35 0.12 1</diffuse></material></visual>
      </link></model>
    <model name="tree_11"><static>true</static><pose>-2.37 -4.45 0 0 0 0</pose>
      <link name="l">
        <visual name="trunk"><pose>0 0 0.88 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>1.76</length></cylinder></geometry>
          <material><ambient>0.35 0.22 0.12 1</ambient><diffuse>0.35 0.22 0.12 1</diffuse></material></visual>
        <visual name="crown"><pose>0 0 2.28 0 0 0</pose><geometry><sphere><radius>0.88</radius></sphere></geometry>
          <material><ambient>0.15 0.35 0.12 1</ambient><diffuse>0.15 0.35 0.12 1</diffuse></material></visual>
      </link></model>
    <model name="tree_12"><static>true</static><pose>13.69 5.12 0 0 0 0</pose>
      <link name="l">
        <visual name="trunk"><pose>0 0 0.95 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>1.89</length></cylinder></geometry>
          <material><ambient>0.35 0.22 0.12 1</ambient><diffuse>0.35 0.22 0.12 1</diffuse></material></visual>
        <visual name="crown"><pose>0 0 2.46 0 0 0</pose><geometry><sphere><radius>0.95</radius></sphere></geometry>
          <material><ambient>0.15 0.35 0.12 1</ambient><diffuse>0.15 0.35 0.12 1</diffuse></material></visual>
      </link></model>
    <model name="tree_13"><static>true</static><pose>3.79 14.65 0 0 0 0</pose>
      <link name="l">
        <visual name="trunk"><pose>0 0 1.19 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>2.37</length></cylinder></geometry>
          <material><ambient>0.35 0.22 0.12 1</ambient><diffuse>0.35 0.22 0.12 1</diffuse></material></visual>
        <visual name="crown"><pose>0 0 3.09 0 0 0</pose><geometry><sphere><radius>1.19</radius></sphere></geometry>
          <material><ambient>0.15 0.35 0.12 1</ambient><diffuse>0.15 0.35 0.12 1</diffuse></material></visual>
      </link></model>

    <!-- KINEMATIC stand-in drone (not PX4 / not x500 dynamics). -->
    <model name="ember_drone">
      <pose>-12 -8 0.15 0 0 0</pose>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial><mass>1.5</mass><inertia><ixx>0.03</ixx><iyy>0.03</iyy><izz>0.05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.4 0.4 0.15</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>0.35 0.35 0.15</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="sim_tag"><pose>0 0 0.09 0 0 0</pose><geometry><box><size>0.2 0.2 0.02</size></box></geometry>
          <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse><emissive>0.6 0.3 0 1</emissive></material></visual>
        <visual name="rotor_0"><pose>0.35 0.35 0.12 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <visual name="arm_0"><pose>0.175 0.175 0.06 0 0 0</pose><geometry><box><size>0.39999999999999997 0.39999999999999997 0.03</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <visual name="rotor_1"><pose>0.35 -0.35 0.12 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <visual name="arm_1"><pose>0.175 -0.175 0.06 0 0 0</pose><geometry><box><size>0.39999999999999997 0.39999999999999997 0.03</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <visual name="rotor_2"><pose>-0.35 0.35 0.12 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <visual name="arm_2"><pose>-0.175 0.175 0.06 0 0 0</pose><geometry><box><size>0.39999999999999997 0.39999999999999997 0.03</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <visual name="rotor_3"><pose>-0.35 -0.35 0.12 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <visual name="arm_3"><pose>-0.175 -0.175 0.06 0 0 0</pose><geometry><box><size>0.39999999999999997 0.39999999999999997 0.03</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <!-- SIMULATED water drop: off until the mission node reports arrival. -->
        <particle_emitter name="sim_water" type="cylinder">
          <pose>0 0 -0.15 0 1.5707 0</pose>
          <emitting>false</emitting>
          <size>0.4 0.4 0.1</size>
          <particle_size>0.25 0.25 0.25</particle_size>
          <lifetime>1.5</lifetime>
          <min_velocity>3</min_velocity>
          <max_velocity>5</max_velocity>
          <scale_rate>0.5</scale_rate>
          <rate>80</rate>
          <material>
            <diffuse>0.3 0.6 1.0</diffuse>
            <specular>0.3 0.6 1.0</specular>
            <pbr><metal><albedo_map>media/puff.png</albedo_map></metal></pbr>
          </material>
        </particle_emitter>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <dimensions>3</dimensions>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </model>
  </world>
</sdf>
