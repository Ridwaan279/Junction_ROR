<?xml version="1.0" encoding="UTF-8"?>
<!--
  EmberWatch PX4 world (world name "emberwatch_px4"). REPRESENTATIVE scene only: flat ground at
  elevation 0, generic trees (visual only, no collision, all below the 10 m cruise altitude).
  NOT a reconstruction of any real terrain or place.
  * Systems = PX4 v1.17 gz_bridge/server.config (minus the camera-streaming and optical-flow
    plugins, unused by x500) + ParticleEmitter. Declaring systems here means Gazebo does not
    load server.config for this world.
  * spherical_coordinates is a placeholder: PX4 sets the real origin from PX4_HOME_LAT/LON/ALT
    (= the simulated launch site computed by `plan_scenario`).
  * Fire, smoke, hazard zone and water drop are spawned at runtime by `fire_sim`.
-->
<sdf version="1.9">
  <world name="emberwatch_px4">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
