<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>emberwatch_drone</name>
  <version>0.1.0</version>
  <description>EmberWatch: adapt one wildfire report snapshot into ONE simulated drone mission
    (Gazebo kinematic stand-in, or PX4 SITL offboard). Simulation only; no real dispatch.</description>
  <maintainer email="noreply@example.org">EmberWatch team</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- px4_offboard_mission additionally needs px4_msgs (release/1.17), built in a
       separate workspace outside this repo; it is intentionally not declared here so
       the Gazebo-only demo builds without PX4. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
