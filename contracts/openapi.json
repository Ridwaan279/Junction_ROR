{
  "openapi":"3.1.0",
  "info":{"title":"EmberWatch baseline API","version":"0.1.0","description":"Run-scoped synthetic replay. Model and dispatch outputs are simulations. Unknown source coverage is never all-clear."},
  "servers":[{"url":"http://127.0.0.1:8080"}],
  "components":{"parameters":{"RunId":{"name":"run_id","in":"query","required":true,"schema":{"type":"string"}}},"schemas":{"Snapshot":{"$ref":"./snapshot.schema.json"},"SourceBatch":{"$ref":"./source-batch.schema.json"},"Event":{"$ref":"./event.schema.json"}}},
  "paths":{
    "/healthz":{"get":{"responses":{"200":{"description":"Service health and storage mode"}}}},
    "/api/scenarios":{"get":{"responses":{"200":{"description":"Available Scenario array"}}}},
    "/api/snapshot":{"get":{"parameters":[{"$ref":"#/components/parameters/RunId"}],"responses":{"200":{"description":"Atomic run snapshot","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Snapshot"}}}},"400":{"description":"Missing run scope"},"404":{"description":"Unknown run"}}}},
    "/api/incidents":{"get":{"parameters":[{"$ref":"#/components/parameters/RunId"}],"responses":{"200":{"description":"Visible Incident array"}}}},
    "/api/incidents/{id}":{"get":{"parameters":[{"$ref":"#/components/parameters/RunId"},{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Incident detail"},"404":{"description":"No incident in this run"}}}},
    "/api/incidents/{id}/timeline":{"get":{"parameters":[{"$ref":"#/components/parameters/RunId"},{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Visible Evidence array with source citations"}}}},
    "/api/incidents/{id}/forecast":{"get":{"parameters":[{"$ref":"#/components/parameters/RunId"},{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Illustrative Forecast array"}}}},
    "/api/incidents/{id}/dispatch":{"post":{"parameters":[{"$ref":"#/components/parameters/RunId"},{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Synthetic-only illustrative Forecast, simulated DronePlan and PT/EN Briefing in Snapshot"},"409":{"description":"Scenario changed during bounded computation; retry"}}}},
    "/webhooks/context":{"post":{"responses":{"202":{"description":"Verified durable receipt stored; not yet ingested"},"200":{"description":"Duplicate receipt"},"401":{"description":"Signature or binding rejected"},"503":{"description":"Disabled without live run, database and independently validated receiver binding"}}}},
    "/api/sources":{"get":{"parameters":[{"$ref":"#/components/parameters/RunId"}],"responses":{"200":{"description":"SourceStatus array including unresolved source checks"}}}},
    "/api/stations":{"get":{"parameters":[{"$ref":"#/components/parameters/RunId"}],"responses":{"200":{"description":"Visible Weather array"}}}},
    "/api/drones":{"get":{"parameters":[{"$ref":"#/components/parameters/RunId"}],"responses":{"200":{"description":"Simulated DronePlan array"}}}},
    "/api/events":{"get":{"parameters":[{"$ref":"#/components/parameters/RunId"}],"responses":{"200":{"description":"Bounded SSE; Event envelope as data; named run.reset and scenario.tick payloads are Snapshot; resync.required requests fresh snapshot","content":{"text/event-stream":{"schema":{"type":"string"}}}}}}},
    "/api/scenarios/{id}/{command}":{"post":{"parameters":[{"$ref":"#/components/parameters/RunId"},{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"command","in":"path","required":true,"schema":{"type":"string","enum":["play","pause","seek","reset"]}}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{"at":{"type":"string","format":"date-time"},"speed":{"type":"number","minimum":0.1,"maximum":3600}}}}}},"responses":{"200":{"description":"Fresh Snapshot","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Snapshot"}}}},"400":{"description":"Invalid command or outside scenario time range"}}}}
  }
}
