# Optional; without a database the demo runs explicitly in memory.
# DATABASE_URL=postgres://emberwatch:local-development-only@localhost:5432/emberwatch
BIND_ADDRESS=127.0.0.1:8080
WEB_ORIGIN=http://localhost:3000
# Agent A uses durable local state without DATABASE_URL.
STATE_PATH=.state/platform.json
ENABLE_LIVE_SOURCES=false
ALLOW_LOCAL_MUTATIONS=false
# OPERATOR_TOKEN=
# FIRMS_MAP_KEY=
# Browser can use Agent A through this compatibility adapter:
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080/platform/ui
# Context credentials remain server-side. Recurring Fogos ingestion is disabled.
# CONTEXT_DEV_API_KEY=
# CONTEXT_WEBHOOK_SECRET=
# CONTEXT_MONITOR_ID=
# CONTEXT_UPSTREAM_ID_POINTER=
# CONTEXT_WEBHOOK_SOURCE_ID=fogos
# Webhooks additionally require a live run, PostgreSQL and a verified payload binding.
